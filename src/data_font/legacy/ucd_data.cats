static inline int anth_is_grapheme_extend(int cp) {
    if (cp < 0x300) return 0;
    int lo = 0, hi = (int)(sizeof(anth_extend_ranges) / sizeof(anth_extend_ranges[0])) - 1;
    while (lo <= hi) {
        int mid = (lo + hi) >> 1;
        if (cp < (int)anth_extend_ranges[mid].start) {
            hi = mid - 1;
        } else if (cp > (int)anth_extend_ranges[mid].end) {
            lo = mid + 1;
        } else {
            return 1;
        }
    }
    return 0;
}

typedef struct {
    uint16_t cp;
    uint8_t grp;
    uint16_t iso, fin, ini, med;
} anth_ar_entry;

