static inline const anth_ar_entry *anth_get_ar_entry(int cp) {
    if (cp < 0x0621 || cp > 0x06AF) return 0;
    int n = (int)(sizeof(anth_ar_shapes) / sizeof(anth_ar_shapes[0]));
    int lo = 0, hi = n - 1;
    while (lo <= hi) {
        int mid = (lo + hi) >> 1;
        if (cp < anth_ar_shapes[mid].cp) hi = mid - 1;
        else if (cp > anth_ar_shapes[mid].cp) lo = mid + 1;
        else return &anth_ar_shapes[mid];
    }
    return 0;
}

static inline int anth_is_ar_transparent(int cp) {
    return ((cp >= 0x064B && cp <= 0x065F) || cp == 0x0670 || (cp >= 0x08D3 && cp <= 0x08E1));
}

