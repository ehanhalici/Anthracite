static inline int anth_bidi_class(int cp) {
    if (cp >= 0 && cp < 128) {
        return anth_ascii_bidi[cp];
    }
    if (cp < 0 || cp > 0x10FFFF) return ANTH_BIDI_ON;
    int lo = 0, hi = (int)(sizeof(anth_bidi_ranges) / sizeof(anth_bidi_ranges[0])) - 1;
    while (lo <= hi) {
        int mid = (lo + hi) >> 1;
        if (cp < (int)anth_bidi_ranges[mid].start) {
            hi = mid - 1;
        } else if (cp > (int)anth_bidi_ranges[mid].end) {
            lo = mid + 1;
        } else {
            return anth_bidi_ranges[mid].bidi_type;
        }
    }
    return ANTH_BIDI_ON;
}

typedef struct {
    uint32_t start;
    uint32_t end;
} anth_range;

