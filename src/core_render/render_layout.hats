#ifndef ANTHRACITE_RENDER_LAYOUT_HATS
#define ANTHRACITE_RENDER_LAYOUT_HATS

macdef RENDER_VERTEX_FLOATS = 8
macdef RENDER_VERTEX_BYTES = RENDER_VERTEX_FLOATS * WORD32_BYTES
macdef RENDER_POSITION_ATTRIBUTE = 0
macdef RENDER_COLOR_ATTRIBUTE = 1
macdef RENDER_TEXTURE_ATTRIBUTE = 2
macdef RENDER_POSITION_COMPONENTS = 2
macdef RENDER_COLOR_COMPONENTS = 4
macdef RENDER_TEXTURE_COMPONENTS = 2
macdef RENDER_POSITION_OFFSET_BYTES = 0
macdef RENDER_COLOR_OFFSET_BYTES = RENDER_POSITION_COMPONENTS * WORD32_BYTES
macdef RENDER_TEXTURE_OFFSET_BYTES = (RENDER_POSITION_COMPONENTS + RENDER_COLOR_COMPONENTS) * WORD32_BYTES

#endif
