macdef GL_UNPACK_ALIGNMENT = $extval(int, "GL_UNPACK_ALIGNMENT")
macdef GL_UNPACK_ROW_LENGTH = $extval(int, "GL_UNPACK_ROW_LENGTH")

fun gl_program(): uint = "mac#anth_make_program"
