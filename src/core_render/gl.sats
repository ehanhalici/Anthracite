fun glTexImage2D(target: int, level: int, internal: int, w: int, h: int, border: int, format: int, ty: int, data: ptr): void = "mac#"
fun glTexSubImage2D(target: int, level: int, x: int, y: int, w: int, h: int, format: int, ty: int, data: ptr): void = "mac#"
