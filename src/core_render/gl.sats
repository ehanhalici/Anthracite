macdef GL_ONE_MINUS_SRC_ALPHA = $extval(int, "GL_ONE_MINUS_SRC_ALPHA")
macdef GL_SCISSOR_TEST = $extval(int, "GL_SCISSOR_TEST")
macdef GL_TEXTURE_2D = $extval(int, "GL_TEXTURE_2D")
