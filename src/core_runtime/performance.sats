#include "core_runtime/performance_ids.h"
%{#
#include "core_runtime/performance.cats"
%}
fun performance_enable(enabled: int): void = "mac#anth_performance_enable"
fun performance_reset(): void = "mac#anth_performance_reset"
fun performance_note(key: int, amount: int): void = "mac#anth_performance_note"
fun performance_value(key: int): ullint = "mac#anth_performance_value"
fun performance_now_ns(): lint = "mac#anth_perf_now_ns"
fun performance_phase_end(phase: int, t0: lint): void = "mac#anth_perf_phase_end"
fun performance_phase_total(phase: int): ullint = "mac#anth_perf_phase_total"
fun performance_phase_count(phase: int): ullint = "mac#anth_perf_phase_count"
fun performance_phase_max(phase: int): ullint = "mac#anth_perf_phase_max"
fun performance_runtime_init(): void = "mac#anth_perf_runtime_init"
fun performance_runtime_dump(tag: string): void = "mac#anth_perf_runtime_dump"
fun performance_set_sample_tag(tag: int): void = "mac#anth_perf_set_sample_tag"
