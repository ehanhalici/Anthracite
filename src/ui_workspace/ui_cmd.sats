datatype Cmd =
  | CMD_NONE
  | CMD_CARET_LEFT
  | CMD_CARET_RIGHT
  | CMD_CARET_UP
  | CMD_CARET_DOWN
  | CMD_CARET_LINE_START
  | CMD_CARET_LINE_END
  | CMD_BACKSPACE
  | CMD_DELETE
  | CMD_SELECT_ALL
  | CMD_DELETE_SELECTION
  | CMD_COLLAPSE_SELECTION
  | CMD_COPY
  | CMD_PASTE
  | CMD_CUT
  | CMD_SAVE
  | CMD_UNDO
  | CMD_REDO
  | CMD_WRAP_BOLD
  | CMD_WRAP_ITALIC
  | CMD_WRAP_WIKILINK
  | CMD_SELECT_LEFT
  | CMD_SELECT_RIGHT
  | CMD_SELECT_UP
  | CMD_SELECT_DOWN
  | CMD_SELECT_LINE_START
  | CMD_SELECT_LINE_END
  | CMD_INDENT
  | CMD_NEWLINE
  | CMD_TEXT_INPUT
  | CMD_OPEN_SEARCH
  | CMD_CLOSE_TAB
  | CMD_NEW_TAB
  | CMD_NEW_FILE
  | CMD_NEW_FOLDER
  | CMD_TOGGLE_VIEW
  | CMD_ESCAPE
  | CMD_WORD_LEFT
  | CMD_WORD_RIGHT
  | CMD_SELECT_WORD_LEFT
  | CMD_SELECT_WORD_RIGHT
  | CMD_DELETE_WORD_LEFT
  | CMD_DELETE_WORD_RIGHT
  | CMD_DOC_START
  | CMD_DOC_END
  | CMD_SELECT_DOC_START
  | CMD_SELECT_DOC_END
  | CMD_PAGE_UP
  | CMD_PAGE_DOWN
  | CMD_SELECT_PAGE_UP
  | CMD_SELECT_PAGE_DOWN
  | CMD_NEXT_TAB
  | CMD_PREV_TAB

fun is_cmd(a: Cmd, b: Cmd): bool
