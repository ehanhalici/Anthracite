#ifndef ANTHRACITE_UTF8_ENCODING_HATS
#define ANTHRACITE_UTF8_ENCODING_HATS

macdef UTF8_MAX_SEQUENCE_BYTES = 4
macdef UTF8_CONTINUATION_BASE = 0x80
macdef UTF8_CONTINUATION_LIMIT = 0xBF
macdef UTF8_CONTINUATION_RADIX = 64
macdef UTF8_TWO_BYTE_BASE = 0xC0
macdef UTF8_TWO_BYTE_MIN_LEAD = 0xC2
macdef UTF8_TWO_BYTE_MAX_LEAD = 0xDF
macdef UTF8_THREE_BYTE_BASE = 0xE0
macdef UTF8_THREE_BYTE_MAX_LEAD = 0xEF
macdef UTF8_FOUR_BYTE_BASE = 0xF0
macdef UTF8_FOUR_BYTE_MAX_LEAD = 0xF4
macdef UTF8_THREE_BYTE_MIN_SECOND = 0xA0
macdef UTF8_SURROGATE_LEAD = 0xED
macdef UTF8_SURROGATE_MAX_SECOND = 0x9F
macdef UTF8_FOUR_BYTE_MIN_SECOND = 0x90
macdef UTF8_FOUR_BYTE_MAX_SECOND = 0x8F

#endif
