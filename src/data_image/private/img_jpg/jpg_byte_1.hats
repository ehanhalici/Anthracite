fun jpg_byte(i: int): int =
  if ilt(i, 72) then jpg_byte_0(i)
  else if ilt(i, 144) then jpg_byte_1(i)
  else if ilt(i, 216) then jpg_byte_2(i)
  else if ilt(i, 288) then jpg_byte_3(i)
  else if ilt(i, 360) then jpg_byte_4(i)
  else if ilt(i, 432) then jpg_byte_5(i)
  else if ilt(i, 504) then jpg_byte_6(i)
  else if ilt(i, 576) then jpg_byte_7(i)
  else jpg_byte_8(i)

extern fun push_jpg_fuel_exhausted(b: &Buf >> _, i: int): void = "mac#anth_die_void"

fun push_jpg_with_fuel {recfuel:nat} .<recfuel>. (recfuel: int(recfuel), b: &Buf >> _, i: int): void =
  if recfuel > 0 then (
    if ige(i, 631) then ()
    else let
      val () = buf_push(b, jpg_byte(i))
    in
      push_jpg_with_fuel(recfuel - 1, b, iadd(i, 1))
    end
  ) else push_jpg_fuel_exhausted(b, i)

fun push_jpg(b: &Buf >> _, i: int): void = push_jpg_with_fuel(airlock_nat(MAX_REC_FUEL), b, i)

implement make_jpg() = let
  var jb = buf_make(640)
  val () = push_jpg(jb, 0)
in
  jb
end
