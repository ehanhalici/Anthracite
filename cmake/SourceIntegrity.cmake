get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(search_roots "${root}/src" "${root}/tests" "${root}/tools/script" "${root}/vendor" "$ENV{PATSHOME}")
file(GLOB_RECURSE sources "${root}/src/*.dats" "${root}/src/*.sats"
  "${root}/src/*.hats" "${root}/src/*.cats" "${root}/src/*.h"
  "${root}/tests/*.dats" "${root}/tests/*.sats" "${root}/tests/*.hats"
  "${root}/tools/*.dats" "${root}/tools/*.sats" "${root}/tools/*.hats")
set(owners "")
foreach(source IN LISTS sources)
  file(READ "${source}" contents)
  get_filename_component(parent "${source}" DIRECTORY)
  string(REGEX MATCHALL "(#[ \t]*include|staload)[^\n]*\"[^\"]+\\.(sats|hats|cats|h)\"" imports "${contents}")
  foreach(import IN LISTS imports)
    string(REGEX REPLACE ".*\"([^\"]+)\"$" "\\1" path "${import}")
    set(found FALSE)
    foreach(base "${parent}" ${search_roots})
      if(EXISTS "${base}/${path}")
        set(found TRUE)
        break()
      endif()
    endforeach()
    if(NOT found)
      message(FATAL_ERROR "Unresolved source import: ${source}: ${path}")
    endif()
  endforeach()
  if(source MATCHES "/src/")
    if(contents MATCHES "/tmp/anth[-_]")
      message(FATAL_ERROR "Shared legacy selftest path; derive fixtures from their private root: ${source}")
    endif()
    if(contents MATCHES "if[ \t]+recfuel[ \t]*>[ \t]*0")
      message(FATAL_ERROR "Synthetic recursion budgets must use recursion_fuel_available: ${source}")
    endif()
    if(contents MATCHES "stb_image[.]h|img_jpg_prog[.]cats|anth_decode_jpg_fallback|stbi_load_from_memory")
      message(FATAL_ERROR "C JPEG decoder belongs only in the test oracle: ${source}")
    endif()
    string(REGEX MATCHALL "(^|\n)[ \t]*assume[ \t]+[A-Za-z_][A-Za-z0-9_]*" assumptions "${contents}")
    foreach(assumption IN LISTS assumptions)
      string(REGEX REPLACE ".*assume[ \t]+" "" owner "${assumption}")
      list(APPEND owners "${owner}")
    endforeach()
  endif()
endforeach()
list(SORT owners)
set(expected_owners App Buf Doc Font Image Plat Rend)
if(NOT owners STREQUAL expected_owners)
  message(FATAL_ERROR "Opaque ownership boundary changed: ${owners}")
endif()

file(GLOB documents "${root}/docs/*.md" "${root}/README.md")
foreach(document IN LISTS documents)
  file(READ "${document}" contents)
  get_filename_component(parent "${document}" DIRECTORY)
  string(REGEX MATCHALL [=[\[[^]]*\]\([^)]*\)]=] links "${contents}")
  foreach(link IN LISTS links)
    string(REGEX REPLACE [=[.*\]\(([^)]*)\)$]=] [=[\1]=] path "${link}")
    if(path MATCHES "^(https?:|#)")
      continue()
    endif()
    string(REGEX REPLACE "#.*$" "" path "${path}")
    if(NOT EXISTS "${parent}/${path}")
      message(FATAL_ERROR "Broken documentation link: ${document}: ${path}")
    endif()
  endforeach()
endforeach()
message(STATUS "Source imports, documentation links and seven opaque owners verified")
