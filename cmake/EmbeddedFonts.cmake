# Embeds every face under fonts/ (if any) into the executable with `.incbin`, so the
# program has no runtime dependency on the source tree. The generated header is
# included by exactly one translation unit (font_embedded.dats); faces are
# addressed as "embedded:<file name without extension>".
set(ANTHRACITE_EMBEDDED_FONT_PREFIX "embedded:")
set(ANTHRACITE_DEFAULT_FONT_NAME "SourceCodePro-Regular")

file(GLOB_RECURSE EMBEDDED_FONT_FILES CONFIGURE_DEPENDS
  "${CMAKE_SOURCE_DIR}/fonts/*.ttf" "${CMAKE_SOURCE_DIR}/fonts/*.otf" "${CMAKE_SOURCE_DIR}/fonts/*.ttc")

# Sorted by face name (case-insensitive): the font picker lists them in this order.
set(EMBEDDED_FONT_KEYS "")
foreach(FONT_FILE IN LISTS EMBEDDED_FONT_FILES)
  get_filename_component(FONT_NAME "${FONT_FILE}" NAME_WLE)
  list(APPEND EMBEDDED_FONT_KEYS "${FONT_NAME}|${FONT_FILE}")
endforeach()
list(SORT EMBEDDED_FONT_KEYS CASE INSENSITIVE)

set(EMBEDDED_FONT_ASM "")
set(EMBEDDED_FONT_DECLARATIONS "")
set(EMBEDDED_FONT_TABLE "")
set(EMBEDDED_FONT_NAMES "")
set(EMBEDDED_FONT_COUNT 0)
foreach(KEY IN LISTS EMBEDDED_FONT_KEYS)
  string(FIND "${KEY}" "|" SEPARATOR)
  string(SUBSTRING "${KEY}" 0 ${SEPARATOR} FONT_NAME)
  math(EXPR PATH_START "${SEPARATOR} + 1")
  string(SUBSTRING "${KEY}" ${PATH_START} -1 FONT_FILE)
  if(FONT_NAME IN_LIST EMBEDDED_FONT_NAMES)
    message(FATAL_ERROR "Two embedded fonts share the name ${FONT_NAME}: embedded references would be ambiguous")
  endif()
  list(APPEND EMBEDDED_FONT_NAMES "${FONT_NAME}")
  set(BEGIN "anth_embedded_font_${EMBEDDED_FONT_COUNT}_begin")
  set(END "anth_embedded_font_${EMBEDDED_FONT_COUNT}_end")
  string(APPEND EMBEDDED_FONT_ASM
    "__asm__(\".pushsection .rodata,\\\"a\\\",@progbits\\n\"\n"
    "  \".balign 16\\n\"\n"
    "  \".globl ${BEGIN}\\n.hidden ${BEGIN}\\n${BEGIN}:\\n\"\n"
    "  \".incbin \\\"${FONT_FILE}\\\"\\n\"\n"
    "  \".globl ${END}\\n.hidden ${END}\\n${END}:\\n\"\n"
    "  \".popsection\\n\");\n")
  string(APPEND EMBEDDED_FONT_DECLARATIONS "extern const unsigned char ${BEGIN}[], ${END}[];\n")
  string(APPEND EMBEDDED_FONT_TABLE
    "  {\"${FONT_NAME}\", \"${ANTHRACITE_EMBEDDED_FONT_PREFIX}${FONT_NAME}\", ${BEGIN}, ${END}},\n")
  math(EXPR EMBEDDED_FONT_COUNT "${EMBEDDED_FONT_COUNT} + 1")
endforeach()

# fonts/ may be absent or empty: nothing is embedded and the system default font is used.
set(EMBEDDED_DEFAULT_FONT_REF "")
if(ANTHRACITE_DEFAULT_FONT_NAME IN_LIST EMBEDDED_FONT_NAMES)
  set(EMBEDDED_DEFAULT_FONT_REF "${ANTHRACITE_EMBEDDED_FONT_PREFIX}${ANTHRACITE_DEFAULT_FONT_NAME}")
endif()
# C forbids zero-length arrays; the table keeps one unused slot when empty.
if(EMBEDDED_FONT_COUNT EQUAL 0)
  set(EMBEDDED_FONT_TABLE "  {0, 0, 0, 0},\n")
  set(EMBEDDED_FONT_SLOTS 1)
else()
  set(EMBEDDED_FONT_SLOTS ${EMBEDDED_FONT_COUNT})
endif()

set(EMBEDDED_FONT_HEADER_TMP "${CMAKE_CURRENT_BINARY_DIR}/anthracite_embedded_fonts.h.tmp")
file(WRITE "${EMBEDDED_FONT_HEADER_TMP}"
"/* Generated by cmake/EmbeddedFonts.cmake. Include from one translation unit only. */
#define ANTHRACITE_EMBEDDED_FONT_COUNT ${EMBEDDED_FONT_COUNT}
#define ANTHRACITE_EMBEDDED_FONT_PREFIX \"${ANTHRACITE_EMBEDDED_FONT_PREFIX}\"
#define ANTHRACITE_EMBEDDED_DEFAULT_FONT \"${EMBEDDED_DEFAULT_FONT_REF}\"
${EMBEDDED_FONT_ASM}${EMBEDDED_FONT_DECLARATIONS}
struct anth_embedded_font { const char *name; const char *ref; const unsigned char *begin; const unsigned char *end; };
static const struct anth_embedded_font anth_embedded_fonts[${EMBEDDED_FONT_SLOTS}] = {
${EMBEDDED_FONT_TABLE}};
")
# COPYONLY keeps the timestamp when nothing changed, so the font TU is not rebuilt needlessly.
configure_file("${EMBEDDED_FONT_HEADER_TMP}" "${CMAKE_CURRENT_BINARY_DIR}/anthracite_embedded_fonts.h" COPYONLY)

set_source_files_properties("${CMAKE_CURRENT_BINARY_DIR}/font_embedded_dats.c" PROPERTIES
  OBJECT_DEPENDS "${EMBEDDED_FONT_FILES};${CMAKE_CURRENT_BINARY_DIR}/anthracite_embedded_fonts.h")
