string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(fixture "${BINARY_DIR}/unifont-contract-${suffix}")
set(WORK_DIR "${fixture}/empty")
file(MAKE_DIRECTORY "${WORK_DIR}")
if(LAYOUT STREQUAL source_relative OR LAYOUT STREQUAL parent_relative)
  file(CREATE_LINK "${SOURCE_DIR}/src" "${fixture}/src" SYMBOLIC RESULT linked)
  if(NOT "${linked}" STREQUAL "0")
    message(FATAL_ERROR "Cannot set up relative font fixture: ${linked}")
  endif()
  if(LAYOUT STREQUAL source_relative)
    set(WORK_DIR "${fixture}")
  endif()
endif()
execute_process(COMMAND "${EXECUTABLE}" "${EXPECTED}"
  WORKING_DIRECTORY "${WORK_DIR}" RESULT_VARIABLE result
  OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 10)
if(NOT "${result}" STREQUAL "0" OR NOT output MATCHES "ok=1([ \n]|$)")
  message(FATAL_ERROR "Unifont path contract failed (${result}): ${output}\n${diagnostics}")
endif()
message(STATUS "${output}")
